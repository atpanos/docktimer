# ---------------------------------------------------------------------------
# Docktimer configuration. Copy to .env and adjust.
# Never commit .env — it contains the session secret.
# ---------------------------------------------------------------------------

# HTTP port inside and (via Compose) outside the container.
APP_PORT=8080

# SQLite database file. In Docker this must live inside the /data volume.
DATABASE_PATH=/data/docktimer.db

# REQUIRED. At least 32 characters. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=change-me

# Default IANA timezone for displays and new rules.
DEFAULT_TIMEZONE=Europe/Berlin

# Docker endpoint. Use tcp://docker-socket-proxy:2375 with the proxy override.
DOCKER_HOST=unix:///var/run/docker.sock

# Graceful stop timeout in seconds (passed to Docker).
CONTAINER_STOP_TIMEOUT=30

# Maximum number of execution log rows (global). Minimum effective value: 1000.
LOG_RETENTION=10000

# Public base URL; used for the ?secure cookie decision when COOKIE_SECURE=auto.
APP_URL=http://localhost:8080

# --------------------------- optional settings ----------------------------

# Keep at most N logs per container (0 = disabled).
LOG_RETENTION_PER_CONTAINER=0

# Absolute session lifetime and idle timeout.
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60

# auto | true | false. auto = Secure when APP_URL starts with https://.
COOKIE_SECURE=auto

# Comma-separated reverse-proxy IPs/CIDRs allowed to set X-Forwarded-*.
# Leave empty to trust no proxy (recommended unless you run one).
TRUSTED_PROXIES=

# Comma-separated container names or ID prefixes Docktimer may control.
# Empty = all containers except the denylist.
CONTAINER_ALLOWLIST=

# Never controllable, even if allowlisted. Names or ID prefixes.
CONTAINER_DENYLIST=docktimer,docker-socket-proxy

# debug | info | warn | error
LOG_LEVEL=info

# 1 = pretty logs + templates reloaded from disk (development only).
DEV_MODE=0

# Group ID of /var/run/docker.sock on the host; needed by the direct-socket
# override so the non-root container can use the socket.
# Detect with: stat -c '%g' /var/run/docker.sock
DOCKER_GID=999
